@app.route("/api/hydra")
@auth.login_required
def api_hydra():
    # فحص مباشر وقوي لحالة Hydra
    path = shutil.which("hydra")
    if not path:
        return jsonify({"installed": False, "message": "Hydra غير مثبتة أو غير موجودة في المسار"})
    try:
        r = subprocess.run([path, "-h"], capture_output=True, text=True, timeout=5)
        out = (r.stdout + "\n" + r.stderr).strip()
        version = next((l.strip() for l in out.splitlines() if "Hydra" in l), "غير معروف")
        return jsonify({"installed": True, "path": path, "version": version, "message": "تم اكتشاف Hydra بنجاح"})
    except Exception as e:
        return jsonify({"installed": True, "path": path, "version": "غير متاح", "message": str(e)})

