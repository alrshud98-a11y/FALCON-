@app.route("/api/system/health")
@auth.login_required
def api_system_health():
    import shutil, os
    issues = []
    if not shutil.which("hydra"): issues.append("Hydra مفقودة")
    if not shutil.which("nmap"): issues.append("Nmap مفقود")
    if not os.path.exists("data/falcon.db"): issues.append("قاعدة البيانات مفقودة")
    
    # فحص الصفحات (إذا كنا في نفس السيرفر)
    try:
        import urllib.request
        urllib.request.urlopen("http://127.0.0.1:5000/", timeout=2)
    except:
        issues.append("الخادم لا يستجيب")
        
    return jsonify({"health": len(issues) == 0, "issues": issues})


@app.route("/api/ai/voice", methods=["POST"])
@auth.login_required
def api_ai_voice():
    # Termux-api يتطلب تسجيل صوتي، لكننا سنستخدم المتصفح للتحويل النصي
    # هذه الواجهة تستقبل النص (من تحويل الصوت في المتصفح) وتعطيه للعراب
    data = request.json or {}
    text = data.get("text", "").strip()
    if not text: return jsonify({"reply": "لم أسمع شيئاً."})
    return jsonify(commander_engine.process_command(text))


@app.route("/livemap")
@auth.login_required
def page_livemap(): return render_template("livemap.html")

@app.route("/api/livemap/scan")
@auth.login_required
def api_livemap_scan():
    try:
        import subprocess, json, socket
        # 1. جلب الشبكات
        res = subprocess.run(["termux-wifi-scaninfo"], capture_output=True, text=True, timeout=15)
        if res.returncode != 0: return jsonify({"success": False, "message": "فشل المسح"})
        networks = json.loads(res.stdout)
        
        # 2. جلب الـ IP الحالي للهاتف (إذا كان متصلاً بالواي فاي)
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect(("8.8.8.8", 80))
            current_ip = s.getsockname()[0]
            s.close()
            # افتراض أن الـ Gateway (الراوتر) هو نفس أول 3 أجزاء + .1
            gateway_ip = ".".join(current_ip.split(".")[:3]) + ".1"
        except:
            current_ip = "غير متصل"
            gateway_ip = "غير معروف"

        devices = []
        for net in networks:
            ssid = net.get("ssid", "مخفية") or "مخفية"
            bssid = net.get("bssid", "غير معروف")
            caps = net.get("capabilities", "")
            security = "مفتوحة 🔓" if "[WPA" not in caps and "[WEP" not in caps else "محمية 🔒"
            
            # فحص سريع للثغرات (كمثال: إذا كانت مفتوحة، نعتبرها ثغرة، ونضيف ملاحظة)
            vuln = "لا توجد ثغرات واضحة"
            if security == "مفتوحة 🔓":
                vuln = "⚠️ شبكة غير مشفرة (ثغرة أمنية)."
                
            devices.append({
                "ssid": ssid,
                "bssid": bssid,
                "signal": net.get("rssi", 0),
                "security": security,
                "ip": current_ip if ssid == "مخفية" else "استخدم IP: " + current_ip,
                "vuln": vuln
            })
            
        return jsonify({"success": True, "count": len(devices), "devices": devices})
    except Exception as e:
        return jsonify({"success": False, "message": str(e)})

